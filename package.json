{
  "name": "poke-bench",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "db:generate": "pnpm --filter @poke-bench/db run db:generate",
    "db:migrate": "pnpm --filter @poke-bench/db run db:migrate",
    "db:seed": "pnpm --filter @poke-bench/db run db:seed",
    "demo": "tsx scripts/demo-battle.ts"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
