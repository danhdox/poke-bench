{
  "name": "@poke-bench/db",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:push": "tsx ../../scripts/run-with-root-env.ts prisma db push --skip-generate",
    "db:migrate": "tsx ../../scripts/run-with-root-env.ts prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx ../../scripts/run-with-root-env.ts tsx src/seed.ts",
    "db:studio": "tsx ../../scripts/run-with-root-env.ts prisma studio"
  },
  "dependencies": {
    "@poke-bench/shared": "workspace:*",
    "@poke-bench/sim": "workspace:*",
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0"
  }
}
