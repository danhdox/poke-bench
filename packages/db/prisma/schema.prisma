generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Agent {
  id           String   @id @default(cuid())
  name         String
  provider     String
  modelId      String?
  systemPrompt String?
  temperature  Float?
  maxTokens    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  battlesAsAgent1 Battle[] @relation("Agent1Battles")
  battlesAsAgent2 Battle[] @relation("Agent2Battles")
  wonBattles      Battle[] @relation("WinnerAgent")
  tournamentParticipants TournamentParticipant[]
}

model Team {
  id               String   @id @default(cuid())
  name             String
  formatId         String
  importable       String
  validationStatus String   @default("pending")
  validationErrors String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  battlesAsTeam1 Battle[] @relation("Team1Battles")
  battlesAsTeam2 Battle[] @relation("Team2Battles")
}

model Battle {
  id             String    @id @default(cuid())
  status         String    @default("pending")
  formatId       String
  agent1Id       String
  agent2Id       String
  team1Id        String
  team2Id        String
  winnerSide     String?
  winnerAgentId  String?
  turnCount      Int       @default(0)
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  configJson     String    @default("{}")
  summaryJson    String    @default("{}")
  
  agent1        Agent     @relation("Agent1Battles", fields: [agent1Id], references: [id])
  agent2        Agent     @relation("Agent2Battles", fields: [agent2Id], references: [id])
  team1         Team      @relation("Team1Battles", fields: [team1Id], references: [id])
  team2         Team      @relation("Team2Battles", fields: [team2Id], references: [id])
  winnerAgent   Agent?    @relation("WinnerAgent", fields: [winnerAgentId], references: [id])
  turns         BattleTurn[]
  tournamentBattles TournamentBattle[]
}

model BattleTurn {
  id                   String   @id @default(cuid())
  battleId             String
  turnNumber           Int
  actingSide           String
  requestType          String
  observationJson      String   @default("{}")
  legalActionsJson     String   @default("[]")
  chosenAction         String
  publicReasoning      String?
  confidence           Float?
  latencyMs            Int      @default(0)
  tokenUsageJson       String?
  fallbackUsed         Boolean  @default(false)
  rawModelResponseJson String?
  logChunk             String?
  
  battle Battle @relation(fields: [battleId], references: [id])
}

model TournamentRun {
  id          String    @id @default(cuid())
  name        String
  status      String    @default("pending")
  configJson  String    @default("{}")
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  summaryJson String    @default("{}")
  
  participants TournamentParticipant[]
  battles      TournamentBattle[]
}

model TournamentParticipant {
  id      String @id @default(cuid())
  runId   String
  agentId String
  
  run   TournamentRun @relation(fields: [runId], references: [id])
  agent Agent         @relation(fields: [agentId], references: [id])
}

model TournamentBattle {
  id       String @id @default(cuid())
  runId    String
  battleId String
  
  run    TournamentRun @relation(fields: [runId], references: [id])
  battle Battle        @relation(fields: [battleId], references: [id])
}
